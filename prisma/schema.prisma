generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ToolType {
  OUTIL
  AGENT
}

enum ToolStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum FavoriteStatus {
  A_TESTER
  EN_COURS
  ADOPTE
}

enum SubmissionStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  role            UserRole         @default(USER)
  motDePasse      String? // tests E2E uniquement (fournisseur Credentials)
  objectif        String? // diagnostic
  niveau          String?
  budget          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  sessions        Session[]
  favorites       Favorite[]
  lists           List[]
  recommendations Recommendation[]
  chatSessions    ChatSession[]
  conversations Conversation[]
  activites     ActiviteUtilisateur[]
  avis          Avis[]
  votes         Vote[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id              String           @id @default(cuid())
  slug            String           @unique
  nom             String
  icone           String? // nom d'icône lucide-react
  ordre           Int              @default(0)
  outils          ToolCategory[]
  toolSubmissions ToolSubmission[]
}

model Tool {
  id          String           @id @default(cuid())
  nom         String
  slug        String           @unique
  url         String
  logo        String?
  description String
  type        ToolType         @default(OUTIL)
  tarif       String // affichage : « Freemium — Pro à 20 $/mois »
  tarifMin    Float? // mensuel indicatif (null = inconnu)
  gratuit     Boolean          @default(false) // version gratuite utilisable
  openSource  Boolean          @default(false)
  langues     String[]         @default(["Français", "Anglais"])
  niveau      String           @default("Débutant")
  objectifs   String[]         @default([])
  fonctions   String[]         @default([])
  casUsage    String[]         @default([])
  misEnAvant  Boolean          @default(false)
  verifieLe   DateTime?
  statut      ToolStatus       @default(PUBLIE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  categories  ToolCategory[]
  favorites   Favorite[]
  listItems   ListItem[]
  soumissions ToolSubmission[]
  avis          Avis[]
  votes         Vote[]

  @@index([statut, misEnAvant])
  @@index([type])
}

model ToolCategory {
  toolId      String
  categorieId String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  categorie   Category @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  @@id([toolId, categorieId])
}

model Favorite {
  id        String         @id @default(cuid())
  userId    String
  toolId    String
  statut    FavoriteStatus @default(A_TESTER)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool           @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

model Avis {
  id            String   @id @default(cuid())
  outilId       String
  utilisateurId String
  note          Int
  contenu       String
  creeLe        DateTime @default(now())
  majLe         DateTime @updatedAt

  outil       Tool @relation(fields: [outilId], references: [id], onDelete: Cascade)
  utilisateur User @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([outilId, utilisateurId])
  @@index([outilId])
}

model Vote {
  id            String   @id @default(cuid())
  outilId       String
  utilisateurId String
  creeLe        DateTime @default(now())

  outil       Tool @relation(fields: [outilId], references: [id], onDelete: Cascade)
  utilisateur User @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([outilId, utilisateurId])
  @@index([outilId])
}

model List {
  id        String     @id @default(cuid())
  userId    String
  nom       String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ListItem[]
  slug          String?  @unique
  estPublique   Boolean  @default(false)
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  toolId    String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([listId, toolId])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String?
  mode      String // "guide" | "conversation"
  question  String
  reponse   String // JSON (guide) ou texte (conversation)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  messages  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ToolSubmission {
  id          String           @id @default(cuid())
  nom         String
  url         String
  description String
  tarif       String?
  categorieId String?
  contact     String?
  statut      SubmissionStatus @default(EN_ATTENTE)
  commentaire String?
  toolId      String?
  createdAt   DateTime         @default(now())
  category    Category?        @relation(fields: [categorieId], references: [id])
  tool        Tool?            @relation(fields: [toolId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Conversation {
  id            String    @id @default(cuid())
  utilisateurId String
  titre         String    @default("Nouvelle conversation")
  creeLe        DateTime  @default(now())
  majLe         DateTime  @updatedAt
  utilisateur   User      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([utilisateurId, majLe])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" ou "assistant"
  contenu        String
  creeLe         DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, creeLe])
}

model ActiviteUtilisateur {
  id            String   @id @default(cuid())
  utilisateurId String
  type          String // ex: "assistant", "favori", "profil", "recherche"
  details       String?
  creeLe        DateTime @default(now())
  utilisateur   User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, creeLe])
}