generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ToolType {
  OUTIL
  AGENT
}

enum ToolStatus {
  BROUILLON
  PUBLIE
  ARCHIVE
}

enum FavoriteStatus {
  A_TESTER
  EN_COURS
  ADOPTE
}

enum SubmissionStatus {
  EN_ATTENTE
  APPROUVE
  REFUSE
}

enum PlanPremium {
  PRO
  ENTREPRISE
}

enum StatutAbonnement {
  ACTIF
  ANNULE
  EXPIRE
}

enum StatutPaiement {
  EN_ATTENTE
  PAYE
  ECHOUE
}

model Abonnement {
  id            String           @id @default(cuid())
  utilisateurId String           @unique
  plan          PlanPremium
  statut        StatutAbonnement @default(ACTIF)
  debutLe       DateTime         @default(now())
  expireLe      DateTime
  annuleLe      DateTime?
  creeLe        DateTime         @default(now())
  majLe         DateTime         @updatedAt
  utilisateur   User             @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  paiements     Paiement[]

  @@index([statut, expireLe])
}

model Paiement {
  id            String         @id @default(cuid())
  utilisateurId String
  abonnementId  String?
  plan          PlanPremium
  montant       Int // en centimes de dollar (299 = 2,99 USD)
  devise        String         @default("USD")
  statut        StatutPaiement @default(EN_ATTENTE)
  reference     String         @unique
  monerooId     String?        @unique // identifiant du paiement chez Moneroo
  canal         String?
  simulation    Boolean        @default(false)
  creeLe        DateTime       @default(now())
  majLe         DateTime       @updatedAt
  utilisateur   User           @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  abonnement    Abonnement?    @relation(fields: [abonnementId], references: [id], onDelete: SetNull)

  @@index([utilisateurId, creeLe])
}

model User {
  id                String                @id @default(cuid())
  name              String?
  email             String                @unique
  emailVerified     DateTime?
  image             String?
  role              UserRole              @default(USER)
  motDePasse        String? // tests E2E uniquement (fournisseur Credentials)
  objectif          String? // diagnostic
  niveau            String?
  budget            String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  accounts          Account[]
  sessions          Session[]
  favorites         Favorite[]
  lists             List[]
  recommendations   Recommendation[]
  chatSessions      ChatSession[]
  conversations     Conversation[]
  activites         ActiviteUtilisateur[]
  avis              Avis[]
  votes             Vote[]
  abonnement        Abonnement?
  paiements         Paiement[]
  // Lot 19 — section « Apprendre »
  promptFavoris     PromptFavori[]
  progressionsTutos ProgressionTuto[]
  // Lot 20 — notifications in-app + parrainage
  notifications     Notification[]
  votesAvis         VoteAvis[]
  refCode           String?               @unique // code personnel pour le lien d'invitation (?ref=…)
  parraineParId     String?
  parrainePar       User?                 @relation("Parrainage", fields: [parraineParId], references: [id], onDelete: SetNull)
  filleuls          User[]                @relation("Parrainage")
  // Lot 23 — table de parrainage (le lien parrain → filleul + sa récompense)
  parrainages       Parrainage[]          @relation("ParrainagesRecus")
  parrainageFilleul Parrainage?           @relation("ParrainagesDonnes")
  // Lot 36 — statut du compte (suspension / bannissement révocables).
  // C'est CE champ que lit auth.ts à chaque requête (blocage de connexion
  // et révocation de session) — ne pas le renommer.
  statut            StatutCompte          @default(ACTIF)
  motifSuspension   String?
  suspenduLe        DateTime?
  // Lot 36 — notes internes des admins (notes = reçues, notesRedigees =
  // rédigées) et historique des suspensions posées par les admins.
  notes             NoteMembre[]          @relation("NotesRecues")
  notesRedigees     NoteMembre[]          @relation("NotesRedigees")
  suspensions       SuspensionUser[]
}

// ── Parrainage : « lien ?ref=… → 1 mois offert » ────────────────────
// Une ligne = un filleul lié à un parrain (filleulId unique : on ne
// peut être parrainé qu'une seule fois). EN_ATTENTE à l'inscription ;
// RECOMPENSE quand le filleul paie (abonnement du parrain prolongé de
// 30 jours). ANNULE = lien cassé manuellement par l'admin (anti-fraude).
enum StatutParrainage {
  EN_ATTENTE
  RECOMPENSE
  ANNULE
}

model Parrainage {
  id           String           @id @default(cuid())
  parrainId    String
  filleulId    String           @unique
  statut       StatutParrainage @default(EN_ATTENTE)
  recompenseLe DateTime?
  creeLe       DateTime         @default(now())
  majLe        DateTime         @updatedAt
  parrain      User             @relation("ParrainagesRecus", fields: [parrainId], references: [id], onDelete: Cascade)
  filleul      User             @relation("ParrainagesDonnes", fields: [filleulId], references: [id], onDelete: Cascade)

  @@index([parrainId])
  @@index([statut, creeLe])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

// ── Articles : actualités et blog ─────────────────────────────────────
enum ArticleType {
  ACTUALITE
  BLOG
}

enum ArticleStatut {
  BROUILLON
  PUBLIE
}

model Article {
  id       String        @id @default(cuid())
  type     ArticleType   @default(BLOG)
  titre    String
  slug     String        @unique
  extrait  String
  contenu  String
  image    String?
  auteur   String        @default("L'équipe Webgiverse")
  statut   ArticleStatut @default(BROUILLON)
  publieLe DateTime?
  vues     Int           @default(0) // Lot 25 — compteur d'affichages de l'article
  creeLe   DateTime      @default(now())
  majLe    DateTime      @updatedAt

  @@index([type, statut, publieLe])
}

model MessageContact {
  id      String   @id @default(cuid())
  nom     String
  email   String
  sujet   String
  message String
  traite  Boolean  @default(false) // marqué "lu" quand tu auras répondu
  creeLe  DateTime @default(now())

  @@index([traite, creeLe])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id              String           @id @default(cuid())
  slug            String           @unique
  nom             String
  icone           String? // nom d'icône lucide-react
  ordre           Int              @default(0)
  outils          ToolCategory[]
  toolSubmissions ToolSubmission[]
}

model Tool {
  id            String           @id @default(cuid())
  nom           String
  slug          String           @unique
  url           String
  logo          String?
  description   String
  type          ToolType         @default(OUTIL)
  tarif         String // affichage : « Freemium — Pro à 20 $/mois »
  tarifMin      Float? // mensuel indicatif (null = inconnu)
  gratuit       Boolean          @default(false) // version gratuite utilisable
  openSource    Boolean          @default(false)
  langues       String[]         @default(["Français", "Anglais"])
  niveau        String           @default("Débutant")
  objectifs     String[]         @default([])
  fonctions     String[]         @default([])
  casUsage      String[]         @default([])
  misEnAvant    Boolean          @default(false)
  verifieLe     DateTime?
  statut        ToolStatus       @default(PUBLIE)
  vues          Int              @default(0) // Lot 25 — compteur d'affichages de la fiche
  // Lot 26 — vérification automatique du lien du site officiel :
  // statutLien = dernier code HTTP observé (0 = injoignable / timeout,
  // 2xx-3xx = lien vivant, ≥ 400 = lien mort). null = jamais vérifié.
  statutLien    Int?
  lienVerifieLe DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  categories    ToolCategory[]
  favorites     Favorite[]
  listItems     ListItem[]
  soumissions   ToolSubmission[]
  avis          Avis[]
  votes         Vote[]

  @@index([statut, misEnAvant])
  @@index([type])
}

model ToolCategory {
  toolId      String
  categorieId String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  categorie   Category @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  @@id([toolId, categorieId])
}

model Favorite {
  id        String         @id @default(cuid())
  userId    String
  toolId    String
  statut    FavoriteStatus @default(A_TESTER)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool           @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

model Avis {
  id            String   @id @default(cuid())
  outilId       String
  utilisateurId String
  note          Int
  contenu       String
  creeLe        DateTime @default(now())
  majLe         DateTime @updatedAt

  outil       Tool @relation(fields: [outilId], references: [id], onDelete: Cascade)
  utilisateur User @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  // Lot 20 — votes « Utile » reçus sur cet avis
  votes VoteAvis[]

  @@unique([outilId, utilisateurId])
  @@index([outilId])
}

// Lot 20 — vote « Utile » d'un membre sur un avis (1 vote max par
// membre et par avis, un 2e clic retire le vote). L'auteur de l'avis
// reçoit une notification in-app à chaque nouveau vote.
model VoteAvis {
  id     String   @id @default(cuid())
  avisId String
  userId String
  creeLe DateTime @default(now())

  avis Avis @relation(fields: [avisId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([avisId, userId])
  @@index([avisId])
}

// Lot 20 — notifications in-app affichées dans la cloche de la topbar
// Metis : vote « Utile » reçu sur un avis, nouveau tuto en lien avec
// les outils favoris, etc. `type` permet de filtrer, `lien` est la
// destination interne quand on clique sur la notification.
model Notification {
  id      String   @id @default(cuid())
  userId  String
  type    String // "VOTE_AVIS", "NOUVEAU_TUTO", ...
  titre   String
  message String
  lien    String?
  lue     Boolean  @default(false)
  creeLe  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lue])
  @@index([userId, creeLe])
}

model Vote {
  id            String   @id @default(cuid())
  outilId       String
  utilisateurId String
  creeLe        DateTime @default(now())

  outil       Tool @relation(fields: [outilId], references: [id], onDelete: Cascade)
  utilisateur User @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([outilId, utilisateurId])
  @@index([outilId])
}

model List {
  id          String     @id @default(cuid())
  userId      String
  nom         String
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ListItem[]
  slug        String?    @unique
  estPublique Boolean    @default(false)
}

model ListItem {
  id        String   @id @default(cuid())
  listId    String
  toolId    String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([listId, toolId])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String?
  mode      String // "guide" | "conversation"
  question  String
  reponse   String // JSON (guide) ou texte (conversation)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  messages  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ToolSubmission {
  id          String           @id @default(cuid())
  nom         String
  url         String
  description String
  tarif       String?
  categorieId String?
  contact     String?
  statut      SubmissionStatus @default(EN_ATTENTE)
  commentaire String?
  toolId      String?
  createdAt   DateTime         @default(now())
  category    Category?        @relation(fields: [categorieId], references: [id])
  tool        Tool?            @relation(fields: [toolId], references: [id])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Conversation {
  id            String    @id @default(cuid())
  utilisateurId String
  titre         String    @default("Nouvelle conversation")
  creeLe        DateTime  @default(now())
  majLe         DateTime  @updatedAt
  utilisateur   User      @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([utilisateurId, majLe])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" ou "assistant"
  contenu        String
  creeLe         DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, creeLe])
}

model ActiviteUtilisateur {
  id            String   @id @default(cuid())
  utilisateurId String
  type          String // ex: "assistant", "favori", "profil", "recherche"
  details       String?
  creeLe        DateTime @default(now())
  utilisateur   User     @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, creeLe])
}

// ── Tutoriels vidéo IA (page /tutoriels) ────────────────────────────
// Collection de tutoriels YouTube ; la LECTURE d'un tuto est réservée
// aux abonnés Premium (Pro / Entreprise) connectés. La liste reste
// publique, comme le catalogue d'outils.
enum NiveauTuto {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

model Tuto {
  id           String            @id @default(cuid())
  slug         String            @unique
  titre        String
  youtubeId    String? // identifiant vidéo YouTube (ex: aBcD123xYz) — null tant que non complété
  miniature    String? // URL d'une miniature personnalisée (sinon i.ytimg.com/vi/{youtubeId}/hqdefault.jpg, sinon placeholder)
  dureeMin     Int // durée en minutes (94 = « 1h34 »)
  niveau       NiveauTuto        @default(DEBUTANT)
  outils       String[]          @default([]) // outils/catégories concernés (ex: ["ChatGPT", "Prompt", "OpenAI"])
  vues         Int               @default(0) // popularité (tri « Plus vus »)
  ordre        Int               @default(0) // rang de pertinence (tri par défaut, du plus pertinent au moins pertinent)
  nouveau      Boolean           @default(false) // récent ajout (tri « Nouveautés »)
  verifieLe    DateTime?
  creeLe       DateTime          @default(now())
  majLe        DateTime          @updatedAt
  progressions ProgressionTuto[]

  @@index([niveau])
  @@index([vues])
}

/**
 * ============================================================
 * BIBLIOTHÈQUE DE PROMPTS IA (/prompts)
 * Lot 17 — catalogue de prompts métiers prêts à l'emploi.
 * La page d'un prompt est accessible à tous (vitrine), mais le
 * contenu complet + la copie sont réservés aux abonnés Premium
 * (Pro / Entreprise) — même logique que les tutoriels vidéo.
 * ============================================================
 */

enum TypePrompt {
  TEXTE
  IMAGE
  CODE
}

model PromptCategorie {
  id      String   @id @default(cuid())
  slug    String   @unique // ex: "marketing", "art-design"
  nom     String // ex: "Marketing"
  ordre   Int      @default(0) // ordre d'affichage dans la bibliothèque
  prompts Prompt[]

  @@index([ordre])
}

model Prompt {
  id            String          @id @default(cuid())
  slug          String          @unique
  titre         String
  emoji         String          @default("✨")
  description   String // aperçu public (1–2 phrases, visible sans compte)
  contenu       String // le prompt complet — réservé aux Premium
  type          TypePrompt      @default(TEXTE)
  modeles       String[]        @default([]) // ex: ["ChatGPT", "Claude", "Gemini"]
  categorieId   String
  categorie     PromptCategorie @relation(fields: [categorieId], references: [id])
  sousCategorie String          @default("") // tag FR, ex: "Réseaux sociaux"
  roles         String[]        @default([]) // slugs FR, ex: ["entrepreneurs", "marketeurs"]
  conseils      String          @default("") // conseils d'utilisation (3 puces)
  utilisation   String          @default("") // comment l'utiliser (variables à remplir)
  vues          Int             @default(0) // popularité (tri « Plus vus »)
  ordre         Int             @default(0) // rang de pertinence (tri par défaut)
  nouveau       Boolean         @default(false) // récent ajout (tri « Nouveautés »)
  creeLe        DateTime        @default(now())
  majLe         DateTime        @updatedAt
  favoris       PromptFavori[]

  @@index([categorieId])
  @@index([vues])
  @@index([type])
}

// ═════════════════════════════════════════════════════════════════
// Lot 19 — section « Apprendre » du dashboard
// ═════════════════════════════════════════════════════════════════

enum StatutTuto {
  EN_COURS
  TERMINE
}

// Prompt IA sauvegardé par un utilisateur (« Mes prompts » du dashboard)
model PromptFavori {
  id       String   @id @default(cuid())
  userId   String
  promptId String
  creeLe   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt   Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([promptId])
}

// Progression d'un utilisateur sur un tutoriel vidéo (« Mes tutoriels »)
model ProgressionTuto {
  id     String     @id @default(cuid())
  userId String
  tutoId String
  statut StatutTuto @default(EN_COURS)
  creeLe DateTime   @default(now())
  majLe  DateTime   @updatedAt
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tuto   Tuto       @relation(fields: [tutoId], references: [id], onDelete: Cascade)

  @@unique([userId, tutoId])
  @@index([tutoId])
}

// Lot 25 — Journal d'audit de la console admin : chaque action sensible
// (création, édition, suppression, bascule) y est tracée automatiquement.
model JournalAdmin {
  id       String   @id @default(cuid())
  adminId  String
  adminNom String?
  action   String // "OUTIL_CREE", "ARTICLE_SUPPRIME", "PROPOSITION_APPROUVEE"…
  cible    String // libellé lisible : « Article : Mon titre », « Outil : ChatGPT »
  details  String?
  creeLe   DateTime @default(now())

  @@index([creeLe])
  @@index([action])
}

// Lot 26 — requêtes tapées dans le moteur de recherche du catalogue
// (/outils?q=…). Alimente la page admin « Recherches » : top des
// termes, requêtes SANS résultat (« or à exploiter » : contenu que les
// visiteurs cherchent et que le catalogue n'a pas) et volume sur
// 30 jours. Aucune donnée personnelle : terme + nb de résultats.
model RequeteRecherche {
  id          String   @id @default(cuid())
  terme       String // terme normalisé (minuscules, espaces réduits)
  nbResultats Int      @default(0) // nombre d'outils trouvés au moment de la recherche
  creeLe      DateTime @default(now())

  @@index([terme])
  @@index([creeLe])
  @@index([nbResultats])
}

// ═════════════════════════════════════════════════════════════════
// Lot 36 — CROISSANCE & MONÉTISATION (complète le lot 34/35)
// Ajoute à la base ce que le code des lots 34/35 attend :
// slots sponsorisés « À la une », codes promo Chariow, envois
// newsletter, récompenses de parrainage, notes internes et
// suspensions de comptes — dans les conventions du projet
// (cuid, creeLe/majLe, enums StatutX, index sur les filtres).
// ═════════════════════════════════════════════════════════════════

// ── Slots sponsorisés « À la une » ──────────────────────────────────
// Une ligne = un emplacement acheté par un annonceur, affiché sur
// l'accueil ou en tête d'une catégorie PENDANT sa période
// (dateDebut → dateFin). Chaque affichage public incrémente
// `impressions`, chaque clic incrémente `clics` — l'admin voit les
// deux compteurs dans /admin/sponsors.
model SlotSponsor {
  id          String   @id @default(cuid())
  titre       String // nom affiché de l'annonce
  url         String // destination du clic
  logo        String? // URL d'un logo (sinon favicon auto)
  description String? // une phrase d'accroche
  emplacement String   @default("ACCUEIL") // "ACCUEIL" ou "CATEGORIE"
  cibleSlug   String? // slug de la catégorie quand emplacement = "CATEGORIE"
  dateDebut   DateTime // début de diffusion (inclus)
  dateFin     DateTime // fin de diffusion (incluse)
  actif       Boolean  @default(true) // interrupteur admin (pause)
  impressions Int      @default(0)
  clics       Int      @default(0)
  creeLe      DateTime @default(now())
  majLe       DateTime @updatedAt

  @@index([actif, dateDebut, dateFin])
  @@index([emplacement, cibleSlug])
}

// ── Codes promo Chariow ─────────────────────────────────────────────
// Un code = une réduction communiquée aux membres, à créer aussi côté
// Chariow. `ConversionCodePromo` enregistre chaque achat attribué au
// code (traçage des ventes), pour la page /admin/codes-promo.
model CodePromo {
  id              String                @id @default(cuid())
  code            String                @unique // ex: "LANCEMENT20" (insensible à la casse côté saisie, stocké en majuscules)
  description     String? // note interne (« Campagne newsletter de mars »)
  typeRemise      String                @default("POURCENTAGE") // "POURCENTAGE" | "MONTANT" | "MOIS_OFFERTS"
  valeur          Int                   @default(0) // pourcentage (20 = -20 %), montant en centimes, ou nombre de mois offerts
  dateDebut       DateTime? // null = valable dès maintenant
  dateFin         DateTime? // null = sans limite de durée
  maxUtilisations Int? // null = illimité
  actif           Boolean               @default(true)
  creeLe          DateTime              @default(now())
  majLe           DateTime              @updatedAt
  conversions     ConversionCodePromo[]

  @@index([actif, dateFin])
}

// Une ligne = un paiement attribué à un code promo (webhook Chariow
// ou retour de paiement). `code` est recopié en clair pour garder
// l'historique même si le code promo est supprimé plus tard.
model ConversionCodePromo {
  id           String    @id @default(cuid())
  codeId       String
  code         String // copie lisible du code au moment de la conversion
  email        String? // email du client Chariow si connu
  userId       String? // membre Webgiverse lié, s'il était connecté
  montantCents Int? // montant payé, en centimes (299 = 2,99 USD)
  creeLe       DateTime  @default(now())
  codePromo    CodePromo @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([creeLe])
}

// ── Newsletter (console admin) ──────────────────────────────────────
// Une ligne = un envoi effectué depuis le composeur /admin/newsletter :
// sujet, contenu HTML rendu, segment ciblé et nombre de destinataires
// réels — l'historique permet de savoir ce qui a déjà été envoyé.
model EnvoiNewsletter {
  id              String   @id @default(cuid())
  sujet           String
  contenuHtml     String
  segment         String   @default("TOUS") // "TOUS", "PREMIUM", "INACTIFS-30J", "PARRAINS-ACTIFS", "INSCRITS-SEMAINE"…
  nbDestinataires Int      @default(0) // destinataires réellement traités
  statut          String   @default("ENVOYE") // "ENVOYE" | "ECHEC"
  creeLe          DateTime @default(now())

  @@index([creeLe])
}

// ── Récompenses de parrainage (livre de comptes) ────────────────────
// Une ligne = une récompense offerte à un parrain quand son filleul
// paie (abonnement prolongé de N jours). Complète Parrainage.statut :
// la table Parrainage dit QUEL lien est récompensé, celle-ci dit
// COMBIEN de jours ont été ajoutés et jusqu'à quand.
model RecompenseParrain {
  id           String    @id @default(cuid())
  parrainId    String
  filleulId    String
  parrainageId String? // lien Parrainage d'origine
  joursOfferts Int       @default(30)
  expireLe     DateTime? // nouvelle date d'expiration de l'abonnement du parrain
  creeLe       DateTime  @default(now())

  @@index([parrainId])
  @@index([creeLe])
}

// ── Suspensions / bannissements de comptes ──────────────────────────
// Une ligne = une suspension (ou un bannissement si finLe est null)
// posée par un admin, avec son motif. Révocable : à la levée,
// leveeLe est rempli et le User.statut repasse à ACTIF.
model SuspensionUser {
  id      String    @id @default(cuid())
  userId  String
  adminId String
  motif   String
  debutLe DateTime  @default(now())
  finLe   DateTime? // null = bannissement indéfini
  leveeLe DateTime? // rempli quand l'admin lève la suspension
  creeLe  DateTime  @default(now())
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([debutLe])
}

// =====================================================================
//  CORRECTIF GESTION MEMBRES — complément à ajouter à prisma/schema.prisma
//  3 ajouts, RIEN à supprimer. Appliquez-les tous les deux, puis lancez :
//      npx prisma generate
//      npx prisma db push        (ou : npx prisma migrate dev --name gestion_membres)
// =====================================================================

// ─────────────────────────────────────────────────────────────────────
//  AJOUT ① — À coller TOUT À LA FIN de schema.prisma
//  (l'enum + le modèle NoteMembre)
// ─────────────────────────────────────────────────────────────────────

enum StatutCompte {
  ACTIF
  SUSPENDU
  BANNI
}

model NoteMembre {
  id       String   @id @default(cuid())
  auteurId String
  cibleId  String
  contenu  String
  creeLe   DateTime @default(now())
  auteur   User     @relation("NotesRedigees", fields: [auteurId], references: [id], onDelete: Cascade)
  cible    User     @relation("NotesRecues", fields: [cibleId], references: [id], onDelete: Cascade)

  @@index([cibleId])
  @@index([auteurId])
}

model SponsorCategorie {
  id       String    @id @default(cuid())
  nom      String    @unique
  slug     String    @unique
  sponsors Sponsor[]
  creeLe   DateTime  @default(now())
}

model Sponsor {
  id          String            @id @default(cuid())
  nom         String
  slug        String            @unique
  description String?
  logoUrl     String?
  siteWeb     String?
  categorieId String?
  categorie   SponsorCategorie? @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  actif       Boolean           @default(true)
  ordre       Int               @default(0)
  creeLe      DateTime          @default(now())

  @@index([categorieId])
}
