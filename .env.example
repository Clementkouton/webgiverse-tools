# ── Base de données PostgreSQL (Neon, Supabase, local…) ─────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/webgiverse?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Connexion Google (Google Cloud Console → Identifiants OAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mails de connexion (magic link) — SMTP
EMAIL_SERVER="smtp://utilisateur:motdepasse@smtp.exemple.com:587"
EMAIL_FROM="Webgiverse <webgiverse@gmail.com>"

# ── API Anthropic — appelée UNIQUEMENT côté serveur ─────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── URL publique (SEO, sitemap, e-mails) ────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Tests E2E uniquement (active Credentials + compte de test du seed)
AUTH_ALLOW_CREDENTIALS="false"
NEXT_PUBLIC_CREDENTIALS_ACTIFS="false"
E2E_TEST_EMAIL="e2e@webgiverse.test"
E2E_TEST_MOT_DE_PASSE="motdepasse-test"
ADMIN_EMAIL="admin@webgiverse.test"
ADMIN_MOT_DE_PASSE="admin-motdepasse-test"